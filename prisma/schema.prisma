// ─── Daily Remittance ──────────────────────────────────────
enum DailyRemitStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

model DailyRemittance {
  id            Int                   @id @default(autoincrement())
  businessId    Int                   @default(1)
  date          DateTime              @db.Date
  totalSales    Decimal               @default(0) @db.Decimal(15, 2)
  cashReceived  Decimal               @default(0) @db.Decimal(15, 2)
  totalExpenses Decimal               @default(0) @db.Decimal(15, 2)
  cashDisbursed Decimal               @default(0) @db.Decimal(15, 2)
  netCash       Decimal               @default(0) @db.Decimal(15, 2)
  vatCollected  Decimal               @default(0) @db.Decimal(15, 2)
  // Cash that left each fund on this date. Persisted rather than recomputed:
  // an approved remittance is a signed document and must not change when an
  // entry is later backdated or voided.
  cashOnHandIn      Decimal           @default(0) @db.Decimal(15, 2)
  cashOnHandOut     Decimal           @default(0) @db.Decimal(15, 2)
  pettyCashIn       Decimal           @default(0) @db.Decimal(15, 2)
  pettyCashOut      Decimal           @default(0) @db.Decimal(15, 2)
  pettyCashGcashOut Decimal?          @db.Decimal(15, 2)
  status        DailyRemitStatus      @default(DRAFT)
  preparedBy    String?               @db.VarChar(100)
  approvedBy    String?               @db.VarChar(100)
  notes         String?               @db.Text
  items         DailyRemittanceItem[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([businessId, date])
  @@index([businessId])
  @@index([status])
  @@index([date])
  @@map("daily_remittances")
}

model DailyRemittanceItem {
  id                Int             @id @default(autoincrement())
  dailyRemittanceId Int
  dailyRemittance   DailyRemittance @relation(fields: [dailyRemittanceId], references: [id], onDelete: Cascade)
  category          String          @db.VarChar(30)
  reference         String?         @db.VarChar(100)
  description       String          @db.VarChar(255)
  amount            Decimal         @db.Decimal(15, 2)
  meta              String?         @db.Text

  @@index([dailyRemittanceId])
  @@index([category])
  @@map("daily_remittance_items")
}

